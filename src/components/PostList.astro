---
// 글 목록 — 홈·태그·카테고리 페이지가 공유한다. 발행 시각 내림차순.
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
const sorted = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) =>
  d.toLocaleString('ko-KR', {
    year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
    hour12: false, timeZone: 'Asia/Seoul',
  });
---
<ul class="postlist">
  {sorted.map((p) => (
    <li>
      <div class="body">
        <span class="date">{fmt(p.data.date)}</span>
        <a class="chip" href={`/category/${p.data.category}/`}>{p.data.category}</a>
        <a class="t" href={`/posts/${p.id}/`}>{p.data.title}</a>
        <p class="d">{p.data.description}</p>
      </div>
      {p.data.image && (
        <a class="thumb" href={`/posts/${p.id}/`} aria-hidden="true" tabindex="-1">
          <img src={p.data.image.src} alt="" loading="lazy" />
        </a>
      )}
    </li>
  ))}
</ul>
