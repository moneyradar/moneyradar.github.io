---
// 태그(종목·키워드) 허브 — "한화오션 주가" 같은 지속 검색어를 받는 자리.
// 새 글이 붙을 때마다 갱신되는 페이지라 신선도 신호도 얻는다.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const byTag = new Map<string, typeof posts>();
  for (const p of posts) for (const t of p.data.tags) byTag.set(t, [...(byTag.get(t) ?? []), p]);
  // 글이 2편 이상인 태그만 페이지를 만든다 — 1편짜리 태그 페이지는 얇은 중복 페이지가 된다.
  return [...byTag.entries()]
    .filter(([, list]) => list.length >= 2)
    .map(([tag, list]) => ({ params: { tag }, props: { tag, posts: list } }));
}
const { tag, posts } = Astro.props;
const latest = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const url = `https://money-radar.kr/tags/${encodeURIComponent(tag)}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${tag} 관련 글`,
    url,
    inLanguage: 'ko',
    isPartOf: { '@type': 'WebSite', name: '머니레이더', url: 'https://money-radar.kr/' },
    hasPart: posts.slice(0, 20).map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `https://money-radar.kr/posts/${p.id}/`, datePublished: p.data.date.toISOString() })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: 'https://money-radar.kr/' },
      { '@type': 'ListItem', position: 2, name: tag, item: url },
    ],
  },
];
---
<Base
  title={`${tag} 주가·이슈 정리 — 머니레이더`}
  description={`${tag} 관련 글 ${posts.length}편. 최근 ${latest?.data.date.toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' })} 업데이트. 시황·특징주·공모주 관점에서 ${tag}의 흐름과 확인 포인트를 정리합니다.`}
  jsonLd={jsonLd}
>
  <nav style="font-size:0.82rem; margin-bottom:10px;"><a href="/tags/" style="color:var(--ink-soft); text-decoration:none;">← 태그 모음</a></nav>
  <div class="hero">
    <h1>{tag}</h1>
    <p>관련 글 {posts.length}편 · 최신순</p>
  </div>
  <PostList posts={posts} />
</Base>
