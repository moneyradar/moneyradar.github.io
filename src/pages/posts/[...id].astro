---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const url = `https://moneyradar.github.io/posts/${post.id}/`;
const fmt = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Seoul',
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    inLanguage: 'ko',
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: { '@type': 'Organization', name: '머니레이더', url: 'https://moneyradar.github.io/' },
    publisher: { '@id': 'https://moneyradar.github.io/#org' },
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    ...(post.data.youtube && {
      video: {
        '@type': 'VideoObject',
        name: post.data.title,
        embedUrl: `https://www.youtube.com/embed/${post.data.youtube}`,
        thumbnailUrl: `https://i.ytimg.com/vi/${post.data.youtube}/hqdefault.jpg`,
        uploadDate: post.data.date.toISOString(),
        description: post.data.description,
      },
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: 'https://moneyradar.github.io/' },
      { '@type': 'ListItem', position: 2, name: post.data.category, item: 'https://moneyradar.github.io/' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base
  title={`${post.data.title} — 머니레이더`}
  description={post.data.description}
  article={{ date: post.data.date, category: post.data.category, tags: post.data.tags }}
  jsonLd={jsonLd}
  ogImage={post.data.image?.src}
>
  <article>
    <span class="chip">{post.data.category}</span>
    <h1>{post.data.title}</h1>
    <p class="meta">{fmt} · 머니레이더</p>
    {post.data.image && (
      <figure class="hero-fig">
        <img class="hero-img" src={post.data.image.src} alt={post.data.image.alt} loading="eager" />
        {post.data.image.credit && (
          <figcaption>
            사진: <a href={post.data.image.credit.url} rel="noopener nofollow">{post.data.image.credit.name}</a> / Pexels
          </figcaption>
        )}
      </figure>
    )}
    <Content />
    {post.data.youtube && (
      <div class="yt">
        <iframe
          src={`https://www.youtube.com/embed/${post.data.youtube}`}
          title={post.data.title}
          allowfullscreen
          loading="lazy"
        />
      </div>
    )}
    <div class="disclaimer">
      본 글은 공개된 보도와 시장 데이터를 정리한 정보 제공 목적의 콘텐츠입니다.
      특정 종목의 매수·매도 추천이 아니며, 투자 판단과 책임은 투자자 본인에게 있습니다.
    </div>
  </article>
</Base>
