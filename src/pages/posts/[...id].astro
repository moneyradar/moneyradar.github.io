---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const url = `https://money-radar.kr/posts/${post.id}/`;

// 관련 글 — 태그가 겹치는 글을 겹침 수·최신순으로 최대 5편. 종목 허브(태그 페이지)로 가는 길목.
const all = await getCollection('posts');
const tagSet = new Set(post.data.tags);
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: p.data.tags.filter((t) => tagSet.has(t)).length }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.p.data.date.valueOf() - a.p.data.date.valueOf())
  .slice(0, 5)
  .map((x) => x.p);
const fmtShort = (d: Date) => d.toLocaleDateString('ko-KR', { month: '2-digit', day: '2-digit', timeZone: 'Asia/Seoul' });
// 태그 페이지는 글 2편 이상인 태그에만 존재한다 — 그 태그만 링크로 만든다.
const tagCount = new Map<string, number>();
for (const p of all) for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const hasTagPage = (t: string) => (tagCount.get(t) ?? 0) >= 2;
const fmt = post.data.date.toLocaleString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit',
  hour12: false, timeZone: 'Asia/Seoul',
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
    inLanguage: 'ko',
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: { '@type': 'Organization', name: '머니레이더', url: 'https://money-radar.kr/' },
    publisher: { '@id': 'https://money-radar.kr/#org' },
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    ...(post.data.youtube && {
      video: {
        '@type': 'VideoObject',
        name: post.data.title,
        embedUrl: `https://www.youtube.com/embed/${post.data.youtube}`,
        thumbnailUrl: `https://i.ytimg.com/vi/${post.data.youtube}/hqdefault.jpg`,
        uploadDate: post.data.date.toISOString(),
        description: post.data.description,
      },
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: 'https://money-radar.kr/' },
      { '@type': 'ListItem', position: 2, name: post.data.category, item: `https://money-radar.kr/category/${encodeURIComponent(post.data.category)}/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base
  title={`${post.data.title} — 머니레이더`}
  description={post.data.description}
  article={{ date: post.data.date, category: post.data.category, tags: post.data.tags }}
  jsonLd={jsonLd}
  ogImage={post.data.image?.src}
>
  <article>
    <a class="chip" href={`/category/${post.data.category}/`}>{post.data.category}</a>
    <h1>{post.data.title}</h1>
    <p class="meta">{fmt} · 머니레이더</p>
    {post.data.image && (
      <figure class="hero-fig">
        <img class="hero-img" src={post.data.image.src} alt={post.data.image.alt} loading="eager" />
        {post.data.image.credit && post.data.image.credit.url && (
          <figcaption>
            사진: <a href={post.data.image.credit.url} rel="noopener nofollow">{post.data.image.credit.name}</a> / Pexels
          </figcaption>
        )}
        {post.data.image.credit && !post.data.image.credit.url && (
          <figcaption>{post.data.image.credit.name} — 기사 내용을 표현한 창작 이미지입니다</figcaption>
        )}
      </figure>
    )}
    <Content />
    {post.data.youtube && (
      <div class="yt">
        <iframe
          src={`https://www.youtube.com/embed/${post.data.youtube}`}
          title={post.data.title}
          allowfullscreen
          loading="lazy"
        />
      </div>
    )}
    <div class="disclaimer">
      본 글은 공개된 보도와 시장 데이터를 정리한 정보 제공 목적의 콘텐츠입니다.
      특정 종목의 매수·매도 추천이 아니며, 투자 판단과 책임은 투자자 본인에게 있습니다.
    </div>
    {post.data.tags.length > 0 && (
      <nav class="tags" aria-label="태그">
        {post.data.tags.map((t) =>
          hasTagPage(t) ? <a class="chip" href={`/tags/${t}/`}>#{t}</a> : <span class="chip">#{t}</span>,
        )}
      </nav>
    )}
    {related.length > 0 && (
      <section class="related">
        <h2>같은 종목·주제의 글</h2>
        <ul>
          {related.map((p) => (
            <li>
              <span class="date">{fmtShort(p.data.date)}</span>
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
